OPENAI_API_KEY=sk-...
GROQ_API_KEY=
PINECONE_API_KEY=...

# Optional overrides (defaults shown)
PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf
PINECONE_INDEX=agentic-ai-ebook
PINECONE_NAMESPACE=ebook
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Cosine-similarity floor: if the best chunk scores below this, the bot refuses to answer
MIN_SCORE=0.25

# ---- Provider options ----
# Default is OpenAI for both. To use a Groq key (gsk_...) for the LLM and free local embeddings instead:
#   EMBEDDING_PROVIDER=huggingface
#   LLM_PROVIDER=groq
#   GROQ_API_KEY=gsk_...
#   PINECONE_INDEX=agentic-ai-ebook-384      (new index: 384-dim vs 1536-dim)
# and install:  python -m pip install -r requirements-groq.txt
